---
import { link } from '../lib/link';
import '@fontsource-variable/dm-sans/index.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { consulting, securityOperations } from '../data/services';
import { images } from '../data/images';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
}
const { title, description, schema = [] } = Astro.props;
// Canonical always points at the production domain, never the staging sub-path.
const pagePath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
const canonical = new URL(pagePath, site.url).href;
const isStaging = import.meta.env.STAGING === 'true' || process.env.STAGING === 'true';
const ogImage = `${images.londonCity.src}?auto=format&fit=crop&w=1200&h=630&q=70`;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organisation`,
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/favicon.svg`,
  image: ogImage,
  slogan: site.masterLine,
  description: site.description,
  telephone: '+44 20 3633 0964',
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  areaServed: [{ '@type': 'City', name: 'London' }, { '@type': 'Country', name: 'United Kingdom' }, 'Worldwide'],
  knowsAbout: [...consulting, ...securityOperations].map((s) => s.name),
};
---
<!doctype html>
<html lang="en-GB" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <meta name="theme-color" content="#F6F5F2" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a href="#top" class="progress-top" aria-label="Back to top" data-progress>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="21" class="progress-top__track" />
        <circle cx="24" cy="24" r="21" class="progress-top__bar" pathLength="1" transform="rotate(-90 24 24)" />
        <path d="M24 30V18M19 23l5-5 5 5" class="progress-top__arrow" />
      </svg>
    </a>

    <style is:global>
      .progress-top {
        position: fixed; right: 20px; bottom: 20px; z-index: 30;
        width: 52px; height: 52px; border-radius: 50%;
        background: color-mix(in srgb, var(--r5-white) 90%, transparent);
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        box-shadow: inset 0 0 0 1px var(--r5-border);
        opacity: 0; transform: translateY(12px) scale(0.9); pointer-events: none;
        transition: opacity var(--r5-dur-base) var(--r5-ease), transform var(--r5-dur-base) var(--r5-ease-out);
      }
      .progress-top.is-visible { opacity: 1; transform: none; pointer-events: auto; }
      @media (max-width: 820px) { .progress-top { display: none; } }
      .progress-top svg { width: 100%; height: 100%; padding: 2px; }
      .progress-top__track { fill: none; stroke: var(--r5-c-06); stroke-width: 2; }
      .progress-top__bar { fill: none; stroke: var(--r5-charcoal); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--p, 0)); }
      .progress-top__arrow { fill: none; stroke: var(--r5-charcoal); stroke-width: 1.5; transition: transform var(--r5-dur-base) var(--r5-ease-out); }
      .progress-top:hover .progress-top__arrow { transform: translateY(-3px); }
    </style>

    <script>
      // Scroll reveals: sections fade up once, children stagger via --i.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        [...el.children].forEach((c, i) => { if (!(c as HTMLElement).style.getPropertyValue('--i')) (c as HTMLElement).style.setProperty('--i', String(i)); });
        io.observe(el);
      });

      // London clock — the site is staffed, and it knows what time it is.
      const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
      if (clocks.length) {
        const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
        const tick = () => { const t = fmt.format(new Date()); clocks.forEach((c) => (c.textContent = t)); };
        tick();
        setInterval(tick, 1000);
      }

      // Back-to-top: the ring fills as you read.
      const prog = document.querySelector<HTMLElement>('[data-progress]');
      if (prog) {
        let raf = 0;
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          const p = max > 0 ? Math.min(1, scrollY / max) : 0;
          prog.style.setProperty('--p', p.toFixed(4));
          prog.classList.toggle('is-visible', scrollY > 700);
          raf = 0;
        };
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
        update();
      }
    </script>
  </body>
</html>
