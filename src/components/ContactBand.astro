---
import { link } from '../lib/link';
// "Speak to a consultant" band — a small charcoal panel, not a full-bleed slab.
import Button from './Button.astro';
import Ring from './Ring.astro';
import Kicker from './Kicker.astro';
import { site, bookHref } from '../data/site';
interface Props { kicker: string; title: string; lead: string; line?: 'consulting' | 'operations' }
const { kicker, title, lead, line } = Astro.props;
const href = line ? link(`/contact/?line=${line}#enquiry`) : bookHref;
---
<section class="section" aria-labelledby="contact-band-title">
  <div class="container">
    <div class="band card card--dark on-dark" data-reveal>
      <div class="band__copy">
        <div class="band__kicker"><Kicker label={kicker} /></div>
        <h2 class="h2" id="contact-band-title">{title}</h2>
        <p class="lead">{lead}</p>
        <div class="btn-row">
          <Button href={href}>Speak to a consultant</Button>
          <Button href={site.phoneHref} variant="ghost" onDark>{site.phone}</Button>
        </div>
      </div>
      <div class="band__ring" aria-hidden="true">
        <Ring ticks bearings={false}>
          <span class="micro band__ring-label">R5 · On call</span>
        </Ring>
      </div>
    </div>
  </div>
</section>

<style>
  .band { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; align-items: center; padding: 64px; border-radius: var(--r5-radius-lg); overflow: hidden; }
  .band__copy { display: grid; gap: 22px; }
  .band__copy .lead { max-width: 44ch; }
  .band__copy .btn-row { margin-top: 12px; }
  .band :global(.kicker__rule) { background: var(--r5-w-45); }
  .band__kicker :global(.kicker) { margin-bottom: 0; }
  .band__ring { width: min(100%, 340px); justify-self: end; }
  .band__ring-label { color: var(--r5-w-45); }
  @media (max-width: 900px) {
    .band { grid-template-columns: 1fr; padding: 40px 28px; }
    .band__ring { display: none; }
  }
</style>
