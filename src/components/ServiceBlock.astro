---
// One service, as an on-page section, in the client's structure:
// quote → line → body → list → closer. H2 = service name, id = anchor (SEO).
import Img from './Img.astro';
import Quote from './Quote.astro';
import type { Service } from '../data/services';
interface Props { service: Service; index: number; line: string; reverse?: boolean }
const { service: s, index, line, reverse = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---
<section class={`svc ${reverse ? 'svc--reverse' : ''}`} id={s.id} aria-labelledby={`${s.id}-title`} data-service>
  <div class="container">
    <div class="svc__main">
      <div class="svc__copy" data-reveal>
        <p class="label"><span class="muted">{line} /</span> <span class="accent">{num}</span></p>
        <h2 class="h2" id={`${s.id}-title`}>{s.name}</h2>
        {s.quote && <Quote quote={s.quote} />}
        <p class="svc__line">{s.line}</p>
        {s.body.map((p) => <p class="body body-secondary">{p}</p>)}
        <div class="svc__list">
          <p class="micro muted">{s.listIntro}</p>
          <ul>
            {s.list.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        {s.closer && <p class="svc__closer">{s.closer}</p>}
      </div>
      <figure class="svc__figure" data-reveal>
        <div class={`svc__media media media--zoom ${reverse ? 'media--cut-bl' : 'media--cut'}`}>
          <Img image={s.image} sizes="(max-width: 900px) 100vw, 42vw" width={1200} height={1500} />
          <figcaption class="media__tag">{s.caption}</figcaption>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .svc { padding-block: var(--r5-section); scroll-margin-top: 80px; }
  .svc__main { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: start; }
  .svc--reverse .svc__copy { order: 2; }
  .svc__copy { position: relative; display: grid; gap: 18px; align-content: start; }
  .svc__copy .h2 { max-width: 18ch; }
  .svc__copy :global(.quote) { margin: 6px 0 4px; }
  .svc__line { font-size: var(--r5-lead); line-height: 1.45; font-weight: 600; max-width: 32ch; }
  .svc__copy .body { max-width: 62ch; }
  .svc__list { display: grid; gap: 14px; margin-top: 8px; padding-top: 20px; border-top: 1px solid var(--r5-border); }
  .svc__list ul { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
  .svc__list li { position: relative; padding-left: 22px; font-size: 15px; line-height: 1.5; }
  .svc__list li::before { content: ''; position: absolute; left: 0; top: 0.42em; width: 10px; height: 10px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--r5-charcoal); }
  .svc__list li::after { content: ''; position: absolute; left: 3.5px; top: calc(0.42em + 3.5px); width: 3px; height: 3px; border-radius: 50%; background: var(--r5-accent); }
  .svc__closer { font-weight: 600; padding-top: 4px; }
  .svc__figure { position: sticky; top: calc(var(--r5-header-h) + 72px); }
  .svc__media { aspect-ratio: 4 / 5; }
  .svc__media :global(img) { position: absolute; inset: 0; }
  @media (max-width: 900px) {
    .svc__main { grid-template-columns: 1fr; gap: 40px; }
    .svc--reverse .svc__copy { order: 0; }
    .svc__figure { position: static; }
    .svc__media { aspect-ratio: 16 / 11; }
  }
  @media (max-width: 560px) { .svc__list ul { grid-template-columns: 1fr; } }
</style>
