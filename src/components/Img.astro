---
// Unsplash placeholder images, served responsively from their CDN.
import { images, type ImageKey } from '../data/images';
interface Props {
  image: ImageKey;
  sizes?: string;
  eager?: boolean;
  width?: number;
  height?: number;
  class?: string;
  alt?: string;
}
const { image, sizes = '(max-width: 820px) 100vw, 50vw', eager = false, width = 1600, height = 1067, class: className, alt } = Astro.props;
const img = images[image];
const widths = [480, 800, 1200, 1600, 2000];
const url = (w: number) => `${img.src}?auto=format&fit=crop&w=${w}&q=68`;
---
<img
  src={url(1200)}
  srcset={widths.map((w) => `${url(w)} ${w}w`).join(', ')}
  sizes={sizes}
  alt={alt ?? img.alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  class={className}
/>
