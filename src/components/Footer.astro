---
import { link } from '../lib/link';
// Charcoal footer — one of the few dark surfaces. Kept compact so dark stays
// well under 15% of any page.
import Logo from './Logo.astro';
import Status from './Status.astro';
import { consulting, securityOperations } from '../data/services';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={link('/')} class="site-footer__badge" aria-label="R5 Global — home">
          <span class="site-footer__badge-lg"><Logo variant="badge" size={200} label="R5 Global badge" /></span>
          <span class="site-footer__badge-sm"><Logo size={88} label="R5 Global" /></span>
        </a>
      </div>

      <nav class="site-footer__cols" aria-label="Footer">
        <div>
          <p class="label accent"><a href={link('/consulting/')}>Consultancy &amp; Intelligence</a></p>
          <ul class="site-footer__svc">
            {consulting.map((s) => <li><a href={link(`/consulting/#${s.id}`)}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="label accent"><a href={link('/security-operations/')}>Security Operations</a></p>
          <ul class="site-footer__svc">
            {securityOperations.map((s) => <li><a href={link(`/security-operations/#${s.id}`)}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="label accent">Company</p>
          <ul>
            <li><a href={link('/about/')}>About</a></li>
            <li><a href={link('/contact/')}>Contact us</a></li>
          </ul>
        </div>
        <div>
          <p class="label accent">Direct</p>
          <ul>
            <li><a class="data" href={site.phoneHref}>{site.phone}</a></li>
            <li class="site-footer__plain">London · Operating globally</li>
            <li class="site-footer__status"><Status onDark /></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__bottom micro">
      <span class="site-footer__latin">{site.latin}</span>
      <span>© {site.name} {year} · {site.registered}</span>
      <span class="site-footer__signoff">Still here? So are we.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--r5-charcoal); color: var(--r5-white); padding: 56px 0 24px; }
  .site-footer__top { display: grid; grid-template-columns: 260px 1fr; gap: 48px; padding-bottom: 48px; }
  .site-footer__badge { display: inline-block; color: var(--r5-white); border-radius: 50%; }
  .site-footer__cols { display: grid; grid-template-columns: 1.3fr 1.3fr 0.7fr 1.1fr; gap: 32px; }
  .site-footer__cols .label { margin-bottom: 18px; }
  .site-footer__cols .label a { color: inherit; font: inherit; }
  .site-footer__badge-sm { display: none; }
  .site-footer__cols ul { display: grid; gap: 9px; }
  .site-footer__cols a, .site-footer__plain { font-size: 14px; line-height: 1.45; color: var(--r5-w-70); text-decoration: none; transition: color var(--r5-dur-fast) var(--r5-ease); }
  .site-footer__cols a:hover { color: var(--r5-white); }
  .site-footer__cols a.data { color: var(--r5-white); font-size: 15px; }
  .site-footer__status { margin-top: 8px; white-space: nowrap; }
  .site-footer__bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px;
    padding-top: 24px; border-top: 1px solid var(--r5-w-12); color: var(--r5-w-45);
  }
  .site-footer__signoff { color: var(--r5-w-70); }
  @media (max-width: 1100px) {
    .site-footer__top { grid-template-columns: 1fr; }
    .site-footer__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .site-footer { padding-top: 40px; }
    .site-footer__top { gap: 32px; padding-bottom: 32px; }
    /* Compact on phones: Main mark (Badge is 200px+ only), no service lists */
    .site-footer__badge-lg { display: none; }
    .site-footer__badge-sm { display: block; }
    .site-footer__cols .site-footer__svc { display: none; }
    .site-footer__cols { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
    .site-footer__cols .label { margin-bottom: 10px; }
    .site-footer__bottom { flex-direction: column; }
  }
</style>
