---
// "The ring, working" — the mark's circle as a live device.
// Draws on load; an orange point orbits. Bezel ticks sit OUTSIDE the ring
// (compass logic) — never inside it, or it turns into a reticle.
import Img from './Img.astro';
import type { ImageKey } from '../data/images';

interface Props {
  image?: ImageKey;
  ticks?: boolean;
  bearings?: boolean;
  orbit?: boolean;
  eager?: boolean;
  class?: string;
  sizes?: string;
}
const { image, ticks = true, bearings = false, orbit = true, eager = false, class: className = '', sizes = '40vw' } = Astro.props;

const C = 200;
const R = 170;
const tickLines = ticks
  ? Array.from({ length: 72 }, (_, i) => {
      const a = (i * 5 * Math.PI) / 180;
      const major = i % 6 === 0;
      const r1 = R + 10;
      const r2 = R + (major ? 20 : 15);
      const f = (n: number) => n.toFixed(2);
      return { x1: f(C + r1 * Math.sin(a)), y1: f(C - r1 * Math.cos(a)), x2: f(C + r2 * Math.sin(a)), y2: f(C - r2 * Math.cos(a)), major };
    })
  : [];
const bearingLabels = [
  { t: '000', x: C, y: C - R - 30, anchor: 'middle' },
  { t: '090', x: C + R + 28, y: C + 3, anchor: 'start' },
  { t: '180', x: C, y: C + R + 38, anchor: 'middle' },
  { t: '270', x: C - R - 28, y: C + 3, anchor: 'end' },
];
---
<div class={`ring ${className}`}>
  {image && (
    <div class="ring__media media">
      <Img image={image} eager={eager} sizes={sizes} width={1200} height={1200} />
    </div>
  )}
  <svg class="ring-svg" viewBox="0 0 400 400" aria-hidden="true">
    <circle class="ring-track" cx={C} cy={C} r={R} />
    {tickLines.map((t) => <line class={`ring-tick ${t.major ? 'ring-tick--major' : ''}`} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
    {bearings && bearingLabels.map((b) => <text class="ring-bearing" x={b.x} y={b.y} text-anchor={b.anchor}>{b.t}</text>)}
    <circle class="ring-line" cx={C} cy={C} r={R} pathLength="1" transform={`rotate(-90 ${C} ${C})`} />
    {orbit && (
      <g class="ring-orbit">
        <circle cx={C} cy={C - R} r="6" />
      </g>
    )}
  </svg>
  <div class="ring__center"><slot /></div>
</div>

<style>
  .ring { position: relative; aspect-ratio: 1; width: 100%; }
  .ring-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring__media { position: absolute; inset: 10.5%; border-radius: 50%; }
  .ring__media :global(img) { position: absolute; inset: 0; }
  .ring__center { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; }
</style>
