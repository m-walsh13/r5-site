---
// A case study card — the whole card is the link. `featured` lays it out wide.
import { link } from '../lib/link';
import Img from './Img.astro';
import Arrow from './Arrow.astro';
import { lineLabel, type CaseStudyEntry } from '../data/caseStudies';
interface Props { item: CaseStudyEntry; featured?: boolean; headingLevel?: 'h2' | 'h3' }
const { item: c, featured = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<a href={link(`/case-studies/${c.slug}/`)} class={`ccard card card--link ${featured ? 'ccard--featured' : ''}`} data-line={c.line}>
  <div class="ccard__media media">
    <Img image={c.image} sizes={featured ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 900px) 100vw, 33vw'} width={1400} height={1000} />
  </div>
  <div class="ccard__body">
    <p class="ccard__tags micro"><span class="accent">{lineLabel[c.line]}</span><span class="muted">· {c.sector}</span></p>
    <H class={featured ? 'h3' : 'h4'}>{c.title}</H>
    <p class="body body-secondary">{c.standfirst}</p>
    <span class="ccard__cta">
      <span>Read case study</span>
      <span class="btn__icon" aria-hidden="true"><Arrow /><Arrow /></span>
    </span>
  </div>
</a>

<style>
  .ccard { display: flex; flex-direction: column; height: 100%; padding: 12px; text-decoration: none; background: var(--r5-white); }
  .ccard__media { aspect-ratio: 16 / 10; border-radius: calc(var(--r5-radius) - 6px); }
  .ccard__media :global(img) { position: absolute; inset: 0; }
  .ccard__body { display: flex; flex-direction: column; gap: 12px; padding: 22px 12px 8px; flex: 1; }
  .ccard__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .ccard__cta {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    margin-top: auto; height: 48px; padding: 0 6px 0 20px; border-radius: var(--r5-pill);
    box-shadow: inset 0 0 0 1px var(--r5-border);
    font: 500 var(--r5-label)/1 var(--r5-mono); letter-spacing: var(--r5-label-ls); text-transform: uppercase;
    transition: background-color var(--r5-dur-base) var(--r5-ease), box-shadow var(--r5-dur-base) var(--r5-ease);
  }
  .ccard__body .body { margin-bottom: 12px; }
  .ccard__cta .btn__icon { width: 36px; height: 36px; background: var(--r5-c-06); color: var(--r5-charcoal); }
  .ccard:hover .ccard__cta { background: var(--r5-c-06); box-shadow: none; }
  .ccard:hover .ccard__cta .btn__icon { background: var(--r5-charcoal); color: var(--r5-white); }
  .ccard:hover .ccard__cta .btn__icon :global(svg:first-child) { transform: translate(150%, -150%); }
  .ccard:hover .ccard__cta .btn__icon :global(svg + svg) { transform: translate(0, 0); }
  .ccard:hover .ccard__media :global(img) { transform: scale(1.04); }

  .ccard--featured { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 12px; }
  .ccard--featured .ccard__media { aspect-ratio: auto; min-height: 380px; }
  .ccard--featured .ccard__body { padding: 32px 24px 12px; justify-content: center; }
  .ccard--featured .ccard__body .body { font-size: var(--r5-lead); line-height: 1.5; }
  @media (max-width: 900px) {
    .ccard--featured { display: flex; }
    .ccard--featured .ccard__media { aspect-ratio: 16 / 10; min-height: 0; }
    .ccard--featured .ccard__body { padding: 22px 12px 8px; }
  }
</style>
