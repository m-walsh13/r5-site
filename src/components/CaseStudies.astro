---
// One featured case study — image plus a short write-up (Molfar model).
// ILLUSTRATIVE PLACEHOLDER: replace with a real engagement, still with no
// client name or identifying detail.
import Img from './Img.astro';
import type { CaseStudy } from '../data/pages';
interface Props { item: CaseStudy }
const { item: c } = Astro.props;
const rows = [
  { label: 'Situation', text: c.situation },
  { label: 'Approach', text: c.approach },
  { label: 'Result', text: c.result },
];
---
<article class="case" data-reveal>
  <div class="case__media media media--cut">
    <Img image={c.image} sizes="(max-width: 900px) 100vw, 50vw" width={1400} height={1050} />
  </div>
  <div class="case__body">
    <div class="case__meta">
      <span class="label accent">Case / {c.ref}</span>
      <span class="chip">Illustrative</span>
    </div>
    <p class="micro muted">{c.sector}</p>
    <h3 class="h3">{c.title}</h3>
    <dl class="case__rows">
      {rows.map((r) => (
        <div>
          <dt class="micro muted">{r.label}</dt>
          <dd class="body">{r.text}</dd>
        </div>
      ))}
    </dl>
    <a class="r5-link" href={`#${c.serviceId}`}><span>{c.service}</span></a>
  </div>
</article>

<style>
  .case { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .case__media { aspect-ratio: 4 / 3; }
  .case__media :global(img) { position: absolute; inset: 0; }
  .case__body { display: grid; gap: 16px; justify-items: start; }
  .case__meta { display: flex; align-items: center; gap: 12px; }
  .case__rows { width: 100%; margin: 8px 0 12px; border-top: 1px solid var(--r5-border); }
  .case__rows div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--r5-border); }
  .case__rows dt { padding-top: 5px; }
  @media (max-width: 900px) {
    .case { grid-template-columns: 1fr; gap: 32px; }
    .case__rows div { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
