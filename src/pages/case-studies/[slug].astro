---
// Case study article — client copy, verbatim. Section headings come from the
// client's document, so each article keeps its own structure.
import { link } from '../../lib/link';
import Button from '../../components/Button.astro';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import CaseCard from '../../components/CaseCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { caseStudies, lineLabel, type CaseStudyEntry } from '../../data/caseStudies';
import { consulting, securityOperations } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((item, i) => ({
    params: { slug: item.slug },
    props: { item, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}

interface Props { item: CaseStudyEntry; next: CaseStudyEntry }
const { item: c, next } = Astro.props;

const allServices = [
  ...consulting.map((s) => ({ ...s, path: '/consulting/' })),
  ...securityOperations.map((s) => ({ ...s, path: '/security-operations/' })),
];
const services = c.services.map((id) => allServices.find((s) => s.id === id)!).filter(Boolean);
const anchor = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: c.title,
    description: c.standfirst,
    author: { '@id': `${site.url}/#organisation` },
    publisher: { '@id': `${site.url}/#organisation` },
    mainEntityOfPage: `${site.url}/case-studies/${c.slug}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: `${site.url}/case-studies/` },
      { '@type': 'ListItem', position: 3, name: c.title, item: `${site.url}/case-studies/${c.slug}/` },
    ],
  },
];
---
<Base title={`${c.title} | Case Study | R5 Global`} description={`${c.standfirst} ${c.sections[0].body[0]}`} schema={schema}>
  <article>
    <header class="art-hero">
      <div class="container">
        <nav class="art-crumb micro" aria-label="Breadcrumb">
          <a href={link('/')}>R5</a><span aria-hidden="true">/</span>
          <a href={link('/case-studies/')}>Case studies</a><span aria-hidden="true">/</span>
          <span aria-current="page">{c.title}</span>
        </nav>
        <p class="art-tags micro"><span class="accent">{lineLabel[c.line]}</span><span class="muted">· {c.sector}</span></p>
        <h1 class="h1 art-title">{c.title}</h1>
        <p class="lead art-standfirst">{c.standfirst}</p>
      </div>
    </header>

    <div class="container">
      <figure class="art-figure media media--cut">
        <Img image={c.image} eager sizes="100vw" width={2000} height={900} />
      </figure>
    </div>

    <div class="container art-layout">
      <aside class="art-aside">
        <dl class="art-meta">
          <div><dt class="micro muted">Sector</dt><dd>{c.sector}</dd></div>
          <div>
            <dt class="micro muted">Services</dt>
            <dd>
              <ul>
                {services.map((s) => <li><a href={link(`${s.path}#${s.id}`)} class="r5-link"><span>{s.name}</span></a></li>)}
              </ul>
            </dd>
          </div>
        </dl>
        <nav class="art-toc" aria-label="In this case study">
          <p class="micro muted">In this case study</p>
          <ol>
            {c.sections.map((s) => <li><a href={`#${anchor(s.heading)}`}>{s.heading}</a></li>)}
          </ol>
        </nav>
      </aside>

      <div class="art-body">
        {c.sections.map((s, i) => (
          <section class="art-section" id={anchor(s.heading)} data-reveal>
            <p class="micro accent">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="h3">{s.heading}</h2>
            {s.body.map((p, j) => <p class={j === 0 ? 'art-lead' : 'body body-secondary'}>{p}</p>)}
          </section>
        ))}
      </div>
    </div>
  </article>

  <section class="section section--band art-next" aria-labelledby="next-title">
    <div class="container">
      <div class="art-next__head">
        <h2 class="h3" id="next-title">Next case study</h2>
        <Button href={link('/case-studies/')} variant="ghost" size="sm">All case studies</Button>
      </div>
      <CaseCard item={next} featured />
    </div>
  </section>

  <ContactBand kicker="Get in touch" title="Tell us what you’re dealing with." line={c.line === 'both' ? undefined : c.line} />
</Base>

<style>
  .art-hero { padding: 28px 0 40px; }
  .art-crumb { display: flex; flex-wrap: wrap; gap: 10px; color: var(--r5-text-secondary); margin-bottom: clamp(32px, 5vw, 56px); }
  .art-crumb a { text-decoration: none; }
  .art-crumb a:hover { color: var(--r5-charcoal); }
  .art-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .art-title { max-width: 18ch; }
  .art-standfirst { max-width: 40ch; margin-top: 20px; color: var(--r5-charcoal); font-weight: 500; }
  .art-figure { aspect-ratio: 21 / 9; margin: 0; }
  .art-figure :global(img) { position: absolute; inset: 0; }

  .art-layout { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 64px; padding-block: var(--r5-section); }
  .art-aside { position: sticky; top: calc(var(--r5-header-h) + 32px); align-self: start; display: grid; gap: 40px; }
  .art-meta { display: grid; gap: 0; border-top: 1px solid var(--r5-border); }
  .art-meta > div { display: grid; gap: 8px; padding: 16px 0; border-bottom: 1px solid var(--r5-border); }
  .art-meta ul { display: grid; gap: 8px; }
  .art-meta .r5-link { font-size: 11px; }
  .art-toc { display: grid; gap: 12px; }
  .art-toc ol { display: grid; gap: 4px; border-left: 1px solid var(--r5-border); }
  .art-toc a { display: block; padding: 6px 0 6px 16px; margin-left: -1px; border-left: 1px solid transparent; text-decoration: none; font-size: 15px; color: var(--r5-text-secondary); transition: color var(--r5-dur-fast), border-color var(--r5-dur-fast); }
  .art-toc a:hover, .art-toc a[aria-current='true'] { color: var(--r5-charcoal); border-left-color: var(--r5-accent); }

  .art-body { display: grid; gap: 64px; max-width: 68ch; }
  .art-section { display: grid; gap: 16px; scroll-margin-top: calc(var(--r5-header-h) + 32px); }
  .art-section .h3 { margin-bottom: 4px; }
  .art-lead { font-size: var(--r5-lead); line-height: 1.55; }

  .art-next__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }

  @media (max-width: 900px) {
    .art-layout { grid-template-columns: 1fr; gap: 40px; }
    .art-aside { position: static; }
    .art-toc { display: none; }
    .art-figure { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  // Highlight the section being read in the side contents list.
  const toc = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.art-toc a').forEach((a) => toc.set(a.hash.slice(1), a));
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      toc.forEach((a, id) => a.setAttribute('aria-current', String(id === e.target.id)));
    }),
    { rootMargin: '-40% 0px -55% 0px' },
  );
  document.querySelectorAll('.art-section').forEach((s) => io.observe(s));
</script>
