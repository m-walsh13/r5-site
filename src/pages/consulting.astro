---
// Consultancy & Intelligence — client copy. Order: overview + numbered menu ·
// 5 services · How we work · Case study · Contact · FAQs (sitemap).
import Base from '../layouts/Base.astro';
import PillarHero from '../components/PillarHero.astro';
import ServiceRail from '../components/ServiceRail.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import CutRule from '../components/CutRule.astro';
import Process from '../components/Process.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseCard from '../components/CaseCard.astro';
import { casesFor } from '../data/caseStudies';
import { link } from '../lib/link';
import ContactBand from '../components/ContactBand.astro';
import Faqs from '../components/Faqs.astro';
import { consulting } from '../data/services';
import { consultingPage as page, consultingIntro } from '../data/pages';
import { faqSchema, servicesSchema, breadcrumbSchema } from '../data/schema';

const schema = [
  servicesSchema('Consultancy & Intelligence services', '/consulting/', consulting),
  faqSchema(page.faqs),
  breadcrumbSchema(consultingIntro.name, '/consulting/'),
];
---
<Base title={page.meta.title} description={page.meta.description} schema={schema}>
  <PillarHero pillar={consultingIntro} line="consulting" image="consultingTable" services={consulting} />

  <div class="services-wrap">
    <ServiceRail services={consulting} label="Consultancy & Intelligence services" />
    {consulting.map((s, i) => (
      <Fragment>
        {i > 0 && <CutRule at={i % 2 ? 38 : 62} />}
        <ServiceBlock service={s} index={i} line="Consultancy & Intelligence" reverse={i % 2 === 1} />
      </Fragment>
    ))}
  </div>

  <Process kicker={page.process.kicker} title={page.process.title} steps={page.process.steps} />

  <section class="section" aria-labelledby="cases-title">
    <div class="container">
      <SectionHead kicker={page.cases.kicker} title={page.cases.title} id="cases-title" />
      <ul class="case-grid" data-reveal>
        {casesFor('consulting').slice(0, 3).map((c) => <li><CaseCard item={c} /></li>)}
      </ul>
      <p class="case-all"><a href={link('/case-studies/')} class="r5-link"><span>All case studies</span></a></p>
    </div>
  </section>

  <ContactBand line="consulting" kicker={page.contact.kicker} title={page.contact.title} />

  <Faqs title="Consultancy & Intelligence FAQs" items={page.faqs} />
</Base>

<style>
  .case-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .case-all { margin-top: 32px; }
  @media (max-width: 1000px) { .case-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .case-grid { grid-template-columns: 1fr; } }
  .services-wrap { position: relative; }
</style>
