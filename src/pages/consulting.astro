---
// Consulting — per sitemap: Overview · 7 services · Case studies · Contact us · FAQs
import Base from '../layouts/Base.astro';
import PillarHero from '../components/PillarHero.astro';
import ServiceRail from '../components/ServiceRail.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import CutRule from '../components/CutRule.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseStudies from '../components/CaseStudies.astro';
import ContactBand from '../components/ContactBand.astro';
import Faqs from '../components/Faqs.astro';
import { consulting } from '../data/services';
import { consultingPage as page } from '../data/pages';
import { faqSchema, servicesSchema, breadcrumbSchema } from '../data/schema';

const schema = [
  servicesSchema('Security consulting services', '/consulting/', consulting),
  faqSchema(page.faqs),
  breadcrumbSchema('Consulting', '/consulting/'),
];
---
<Base title={page.meta.title} description={page.meta.description} schema={schema}>
  <PillarHero
    crumb="Consulting"
    kicker={page.hero.kicker}
    title={page.hero.title}
    lead={page.hero.lead}
    body={page.hero.body}
    image="consultingTable"
    services={consulting}
    count="07"
  />

  <div class="services-wrap">
    <ServiceRail services={consulting} label="Consulting services" />
    {consulting.map((s, i) => (
      <Fragment>
        {i > 0 && <CutRule at={i % 2 ? 38 : 62} />}
        <ServiceBlock service={s} index={i} line="Consulting" reverse={i % 2 === 1} />
      </Fragment>
    ))}
  </div>

  <section class="section section--band" aria-labelledby="cases-title" data-services-end>
    <div class="container">
      <SectionHead kicker={page.cases.kicker} title={page.cases.title} lead={page.cases.lead} id="cases-title" />
      <CaseStudies item={page.cases.item} />
    </div>
  </section>

  <ContactBand line="consulting" kicker={page.contact.kicker} title={page.contact.title} lead={page.contact.lead} />

  <Faqs title="Consulting FAQs" items={page.faqs} />
</Base>

<style>
  .services-wrap { position: relative; }
</style>
