---
import { link } from '../lib/link';
// Home — client copy (R5 Global Website Copy, 28 Oct 2026), in the client's order:
// Opening · Consultancy overview · Operations overview · Why R5 · Sectors
// (+ accreditations, from the sitemap) · Client reviews · Contact.
// "Selected work" previews: Myles to add.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import HeroDial from '../components/HeroDial.astro';
import Status from '../components/Status.astro';
import SectionHead from '../components/SectionHead.astro';
import Kicker from '../components/Kicker.astro';
import Quote from '../components/Quote.astro';
import Arrow from '../components/Arrow.astro';
import CutRule from '../components/CutRule.astro';
import Img from '../components/Img.astro';
import SectorMarquee from '../components/SectorMarquee.astro';
import Accreditations from '../components/Accreditations.astro';
import Reviews from '../components/Reviews.astro';
import BookingPanel from '../components/BookingPanel.astro';
import CaseCard from '../components/CaseCard.astro';
import { caseStudies } from '../data/caseStudies';
import { home, consultingIntro, operationsIntro, contactCta } from '../data/pages';
import { site, contactHref } from '../data/site';
import { consulting, securityOperations } from '../data/services';

const words = home.opening.title.split(' ');
// Selected work: one featured + two more, mixing both service lines.
const selected = ['raising-canes', 'nike-after-dark-tour-london', 'critical-infrastructure-penetration-testing'].map((slug) => caseStudies.find((c) => c.slug === slug)!);
const pillars = [
  { key: 'consulting', intro: consultingIntro, href: link('/consulting/'), image: 'consultingTable', services: consulting, band: false },
  { key: 'operations', intro: operationsIntro, href: link('/security-operations/'), image: 'reception', services: securityOperations, band: true },
] as const;
---
<Base title={home.meta.title} description={home.meta.description}>
  <!-- Opening -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="label accent hero__kicker">{home.opening.kicker}</p>
        <h1 class="h1 hero__title" id="hero-title">
          {words.map((w, i) => <Fragment><span class="w"><span style={`--w:${i}`}>{w}</span></span>{i < words.length - 1 && ' '}</Fragment>)}
        </h1>
        <p class="lead hero__lead">{home.opening.body[0]}</p>
        <div class="btn-row hero__cta">
          <Button href={contactHref}>{home.opening.cta}</Button>
          <Button href="#services" variant="ghost">{home.opening.secondaryCta}</Button>
        </div>
        <Status class="hero__status" />
      </div>

      <div class="hero__visual">
        <HeroDial />
      </div>
    </div>
  </section>

  <!-- Approach: the opening's quote and the rest of its copy, given room -->
  <section class="section section--band approach" aria-label={home.opening.approachKicker}>
    <div class="container approach__grid" data-reveal>
      <div class="approach__quote">
        <Kicker label={home.opening.approachKicker} />
        <Quote quote={home.opening.quote} />
      </div>
      <div class="approach__copy">
        {home.opening.body.slice(1).map((p, i) => <p class={i === 0 ? 'approach__lead' : 'body body-secondary'}>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Consultancy overview · Operations overview -->
  {pillars.map((p, idx) => (
    <section class={`section pillar-intro ${p.band ? 'section--band pillar-intro--reverse' : ''}`} id={idx === 0 ? 'services' : undefined} aria-labelledby={`${p.key}-title`}>
      <div class="container pillar-intro__grid">
        <div class="pillar-intro__copy" data-reveal>
          <h2 class="h2" id={`${p.key}-title`}>{p.intro.name}</h2>
          <Quote quote={p.intro.quote} />
          <p class="pillar-intro__line">{p.intro.line}</p>
          {p.intro.body.map((t) => <p class="body body-secondary">{t}</p>)}
          {p.intro.closer && <p class="pillar-intro__closer">{p.intro.closer}</p>}
        </div>
        <a href={p.href} class="pillar card card--link" data-reveal>
          <div class="pillar__media media media--cut">
            <Img image={p.image} sizes="(max-width: 900px) 100vw, 46vw" width={1400} height={900} />
          </div>
          <div class="pillar__body">
            <ol class="pillar__list">
              {p.services.map((s, i) => <li><span class="micro muted">{String(i + 1).padStart(2, '0')}</span>{s.name}</li>)}
            </ol>
            <span class="pillar__cta">
              <span>{p.intro.cta}</span>
              <span class="btn__icon" aria-hidden="true"><Arrow /><Arrow /></span>
            </span>
          </div>
        </a>
      </div>
    </section>
  ))}

  <!-- Why R5 -->
  <section class="section why" aria-labelledby="why-title">
    <div class="container">
      <div class="why__intro" data-reveal>
        <div class="why__head">
          <Kicker label={home.why.kicker} />
          <Quote quote={home.why.quote} />
          <h2 class="h2" id="why-title">{home.why.title}</h2>
        </div>
        <div class="why__side">
          <p class="lead">{home.why.lead}</p>
          <a href={link('/about/#team')} class="r5-link"><span>{home.why.cta}</span></a>
        </div>
      </div>
      <ul class="why__tiles" data-reveal>
        {home.why.points.map((pt, i) => (
          <li class={`card why__tile ${i === 1 ? 'card--dark on-dark' : ''}`}>
            <span class={`micro ${i === 1 ? 'why__dim' : 'muted'}`}>{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h4">{pt.title}</h3>
            <p class="body body-secondary">{pt.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CutRule at={58} />

  <!-- Sectors (+ accreditations) -->
  <section class="section proof" aria-labelledby="proof-title">
    <div class="container">
      <SectionHead kicker={home.sectors.kicker} title={home.sectors.title} lead={home.sectors.lead} id="proof-title" />
      <Accreditations />
    </div>
    <div class="proof__marquee"><SectorMarquee /></div>
  </section>

  <CutRule at={34} />

  <!-- Client reviews -->
  <section class="section" aria-labelledby="reviews-title">
    <div class="container">
      <SectionHead kicker={home.reviews.kicker} title={home.reviews.title} lead={home.reviews.lead} id="reviews-title" />
      <Reviews count={3} />
    </div>
  </section>

  <!-- Selected work (client's homepage previews) -->
  <section class="section selected" aria-labelledby="selected-title">
    <div class="container">
      <SectionHead kicker="Selected work" title="Proven on the ground." lead="Case studies from across our consultancy and security operations." id="selected-title" />
      <div class="selected__featured" data-reveal><CaseCard item={selected[0]} featured /></div>
      <ul class="selected__grid" data-reveal>
        {selected.slice(1).map((c) => <li><CaseCard item={c} /></li>)}
      </ul>
      <div class="selected__all"><Button href={link('/case-studies/')} variant="ghost">All case studies</Button></div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section section--band book" aria-labelledby="book-title">
    <div class="container book__grid">
      <div class="book__copy" data-reveal>
        <Kicker label="Contact" />
        <h2 class="h2" id="book-title">{contactCta.title}</h2>
        <p class="lead">{contactCta.lead}</p>
        <Button href={contactHref}>{contactCta.cta}</Button>
        <p class="data">Prefer the phone? <a href={site.phoneHref}>{site.phone}</a></p>
      </div>
      <BookingPanel compact />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding: clamp(40px, 7vw, 88px) 0 clamp(56px, 8vw, 104px); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: 48px; align-items: center; }
  .hero__copy { display: grid; gap: 28px; justify-items: start; }
  .hero__kicker { animation: fade-up 800ms var(--r5-ease-out) both; }
  .hero__title { max-width: 13ch; font-size: clamp(40px, 5.6vw, var(--r5-h1)); }
  .hero__title .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .hero__title .w > span { display: inline-block; animation: word-up 1000ms var(--r5-ease-out) both; animation-delay: calc(120ms + var(--w) * 90ms); }
  .hero__lead { max-width: 40ch; animation: fade-up 900ms var(--r5-ease-out) 520ms both; }
  .hero__cta { animation: fade-up 900ms var(--r5-ease-out) 640ms both; }
  .hero__status { animation: fade-up 900ms var(--r5-ease-out) 760ms both; }
  .hero__visual { position: relative; width: min(100%, 560px); justify-self: end; padding: 36px; animation: fade-in 1400ms var(--r5-ease) 200ms both; }
  @keyframes word-up { from { transform: translateY(105%); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } }
  @keyframes fade-in { from { opacity: 0; transform: scale(0.97); } }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; gap: 24px; }
    .hero__visual { justify-self: center; width: min(100%, 440px); order: -1; padding: 20px; }
  }

  /* Proof */
  .proof__marquee { margin-top: 56px; }

  /* Approach */
  .approach__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px 64px; align-items: start; }
  .approach__quote { display: grid; gap: 24px; }
  .approach__quote :global(.kicker) { margin-bottom: 0; }
  .approach__quote :global(.quote p) { font-size: var(--r5-h3); line-height: 1.3; color: var(--r5-charcoal); }
  .approach__copy { display: grid; gap: 18px; max-width: 60ch; padding-top: 44px; }
  .approach__lead { font-size: var(--r5-lead); line-height: var(--r5-lead-lh); }
  @media (max-width: 900px) {
    .approach__grid { grid-template-columns: 1fr; }
    .approach__copy { padding-top: 0; }
  }

  /* Pillar overviews (client copy) */
  .pillar-intro__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  .pillar-intro--reverse .pillar-intro__copy { order: 2; }
  .pillar-intro__copy { display: grid; gap: 18px; justify-items: start; }
  .pillar-intro__copy :global(.quote) { margin: 4px 0; }
  .pillar-intro__line { font-size: var(--r5-lead); line-height: 1.45; font-weight: 600; }
  .pillar-intro__copy .body { max-width: 54ch; }
  .pillar-intro__closer { font-weight: 600; }
  @media (max-width: 900px) {
    .pillar-intro__grid { grid-template-columns: 1fr; gap: 40px; }
    .pillar-intro--reverse .pillar-intro__copy { order: 0; }
  }
  .pillar { position: relative; display: flex; flex-direction: column; padding: 12px; text-decoration: none; background: var(--r5-white); cursor: pointer; }
  .pillar__cta {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    margin-top: auto; height: 52px; padding: 0 8px 0 22px; border-radius: var(--r5-pill);
    box-shadow: inset 0 0 0 1px var(--r5-border);
    font: 500 var(--r5-label)/1 var(--r5-mono); letter-spacing: var(--r5-label-ls); text-transform: uppercase;
    transition: background-color var(--r5-dur-base) var(--r5-ease), box-shadow var(--r5-dur-base) var(--r5-ease);
  }
  .pillar__cta .btn__icon { background: var(--r5-c-06); color: var(--r5-charcoal); }
  .pillar:hover .pillar__cta { background: var(--r5-c-06); box-shadow: none; }
  .pillar:hover .pillar__cta .btn__icon { background: var(--r5-charcoal); color: var(--r5-white); }
  .pillar:hover .pillar__cta .btn__icon :global(svg:first-child) { transform: translate(150%, -150%); }
  .pillar:hover .pillar__cta .btn__icon :global(svg + svg) { transform: translate(0, 0); }
  .pillar__media { aspect-ratio: 16 / 10; border-radius: calc(var(--r5-radius) - 6px); }
  .pillar__body { display: flex; flex-direction: column; gap: 14px; padding: 16px 12px 8px; flex: 1; }
  .pillar__list { display: grid; gap: 0; margin: 0 0 8px; }
  .pillar__list li + li { border-top: 1px solid var(--r5-border); }
  .pillar__list li { display: flex; gap: 14px; padding: 12px 0; font-size: 16px; font-weight: 500; line-height: 1.45; }
  .pillar__list .micro { padding-top: 3px; }
  @media (max-width: 560px) { .pillar__body { padding: 12px 8px 8px; } }

  /* Why */
  .why__intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 64px; align-items: end; margin-bottom: 56px; }
  .why__head { display: grid; gap: 22px; justify-items: start; }
  .why__head :global(.kicker) { margin-bottom: 0; }
  .why__side { display: grid; gap: 20px; justify-items: start; }
  .why__tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .why__tile { display: flex; flex-direction: column; gap: 14px; }
  .why__tile .micro { margin-bottom: 24px; }
  .why__dim { color: var(--r5-w-45); }
  @media (max-width: 900px) {
    .why__intro { grid-template-columns: 1fr; margin-bottom: 40px; }
    .why__tiles { grid-template-columns: 1fr; }
  }

  /* Selected work */
  .selected__featured { margin-bottom: 16px; }
  .selected__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .selected__all { margin-top: 32px; display: flex; justify-content: center; }
  @media (max-width: 640px) { .selected__grid { grid-template-columns: 1fr; } }

  /* Book */
  .book__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: center; }
  .book__copy { display: grid; gap: 22px; justify-items: start; }
  .book__copy :global(.kicker) { margin-bottom: 4px; }
  .book__copy a { color: var(--r5-charcoal); }
  @media (max-width: 900px) { .book__grid { grid-template-columns: 1fr; gap: 40px; } }

  @media (prefers-reduced-motion: reduce) {
    .hero__title .w > span, .hero__kicker, .hero__lead, .hero__cta, .hero__status, .hero__visual { animation: none; }
  }
</style>
